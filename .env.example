# Application database
DATABASE_URL=sqlite:///database/irtiqa.db

# SQLAlchemy logging
DATABASE_ECHO=false

# Connection health checks
DATABASE_POOL_PRE_PING=true

# SQLite foreign key enforcement
SQLITE_FOREIGN_KEYS=true
SQLITE_JOURNAL_MODE=WAL
SQLITE_BUSY_TIMEOUT_MS=5000

# Development mode
# Enables dev-only features: verification tokens in responses and server logs,
# relaxed validation, etc.  Safe for local development; never enable in production.
DEV_MODE=true

# Logging
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
DATABASE_LOG_LEVEL=WARNING
REPOSITORY_LOG_LEVEL=INFO
LOG_CONSOLE_ENABLED=true
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/irtiqa.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_DATE_FORMAT=%Y-%m-%dT%H:%M:%S%z
